{
  "name": "lapis-obsidian-client",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone HTML5 Lapis Obsidian Client",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "npm run build",
    "test": "node scripts/build.mjs && node scripts/test-server.mjs && node --test tests/*.test.mjs",
    "test:web": "node scripts/build.mjs && node scripts/test-server.mjs && node tests/browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "ws": "8.22.0"
  }
}
